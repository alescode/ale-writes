---
layout: null
permalink: /feed.xml
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ site.title | xml_escape }}</title>
  <subtitle>{{ site.description | xml_escape }}</subtitle>
  <link href="{{ '/feed.xml' | absolute_url }}" rel="self" type="application/atom+xml" />
  <link href="{{ '/' | absolute_url }}" rel="alternate" type="text/html" />
  <id>{{ '/' | absolute_url }}</id>
  {% assign sorted_posts = site.my_posts | sort: "date" | reverse %}
  {% assign newest_post = sorted_posts | first %}
  <updated>{{ newest_post.date | date_to_xmlschema }}</updated>
  {% for post in sorted_posts %}
  <entry>
    <title>{{ post.title | xml_escape }}</title>
    <link href="{{ post.url | absolute_url }}" rel="alternate" type="text/html" />
    <id>{{ post.url | absolute_url }}</id>
    <published>{{ post.date | date_to_xmlschema }}</published>
    <updated>{{ post.last_modified_at | default: post.date | date_to_xmlschema }}</updated>
    <summary type="html">{{ post.description | default: post.excerpt | strip_html | normalize_whitespace | xml_escape }}</summary>
  </entry>
  {% endfor %}
</feed>
